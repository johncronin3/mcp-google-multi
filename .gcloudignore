# gcloud run deploy --source uses this as the build context.
# Keep only the files the house Dockerfile COPYs, plus the Dockerfile so
# Cloud Build runs those COPY steps instead of buildpacks.
# bin/ and loose *.mjs scripts stay out. Last match wins.
*
# A file under an excluded directory cannot be re-included.
!*/
# Leading slash: these names must not match node_modules/**/package.json.
!/Dockerfile
!/package.json
!/package-lock.json
!/tsconfig.json
!/src/**
# Last match wins. Re-exclude secrets the src allow would otherwise upload.
src/**/.env*
src/**/*.enc
src/**/*.pem
src/**/*.key
src/**/*.p12
src/**/*.pfx
src/**/*.token
src/**/master.key
src/**/id_rsa
src/**/id_rsa.*
src/**/credentials.json
src/**/*credentials*.json
src/**/mcp-tokens.enc
!/docker/entrypoint.sh
bin/
*.mjs
